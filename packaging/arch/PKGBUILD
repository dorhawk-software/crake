# Maintainer: dorhawk.software <ondrej@dorhawk.software>
# Crake for Arch (the AUR): built from a release's source with Arch's Rust.
# scripts/build-arch.sh builds it from the current commit instead, and
# scripts/deb-test.sh archlinux:latest tests it.
pkgname=crake
pkgver=0.2.0
pkgrel=1
pkgdesc="VPN client that routes only what needs the tunnel"
arch=('x86_64')
url="https://dorhawk.software/crake/"
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('glibc' 'gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'nftables' 'iproute2' 'systemd' 'polkit' 'dbus')
makedepends=('rust' 'cmake' 'pkgconf' 'fontconfig' 'freetype2')
# pacman can't say "one of these": each engine is optional, and the app
# says which one a tunnel needs when it isn't installed.
optdepends=('openconnect: AnyConnect, GlobalProtect, Fortinet and the other openconnect protocols'
            'openvpn3: OpenVPN 3 profiles (AUR)'
            'gnome-shell-extension-appindicator: the tray icon on GNOME'
            'gnome-keyring: keeping passwords and certificates')
backup=('etc/crake/craked.toml')
# makepkg's -flto turns the C parts of crates (wayland-backend's log
# trampoline) into GCC bitcode that Rust's linker (lld) can't read.
options=('!lto')
install=crake.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/dorhawk-software/crake/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # filled in with the first release

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  # target in the source tree, unless the builder keeps one elsewhere
  # (scripts/build-arch.sh in CI, between runs).
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --frozen --release -p crake -p craked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}"/release/crake "$pkgdir/usr/bin/crake"
  install -Dm755 "${CARGO_TARGET_DIR:-target}"/release/craked "$pkgdir/usr/bin/craked"
  # Arch keeps helpers in /usr/lib/<package>, not /usr/libexec.
  install -Dm755 "${CARGO_TARGET_DIR:-target}"/release/crake-hook "$pkgdir/usr/lib/crake/hook"
  install -Dm644 packaging/craked.service "$pkgdir/usr/lib/systemd/system/craked.service"
  install -Dm644 packaging/software.dorhawk.Crake1.conf "$pkgdir/usr/share/dbus-1/system.d/software.dorhawk.Crake1.conf"
  install -Dm644 packaging/software.dorhawk.crake.policy "$pkgdir/usr/share/polkit-1/actions/software.dorhawk.crake.policy"
  install -Dm644 packaging/deb/crake.desktop "$pkgdir/usr/share/applications/software.dorhawk.crake.desktop"
  install -Dm644 assets/icons/app/crake.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/software.dorhawk.crake.svg"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/app/crake-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x$s/apps/software.dorhawk.crake.png"
  done
  install -Dm644 packaging/deb/craked.toml "$pkgdir/etc/crake/craked.toml"
  printf '\n# Arch: the hook lives in /usr/lib/crake.\nhook_path = "/usr/lib/crake/hook"\n' >> "$pkgdir/etc/crake/craked.toml"
  install -dm755 "$pkgdir/etc/crake/managed.d"
  install -Dm644 packaging/craked.toml.example "$pkgdir/usr/share/doc/crake/craked.toml.example"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/crake/LICENSE"
  install -Dm644 assets/fonts/OFL-*.txt -t "$pkgdir/usr/share/licenses/crake/"
}
