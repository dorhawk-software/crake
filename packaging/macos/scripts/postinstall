#!/bin/sh
# After the files are in place. craked is Crake.app's own service: the app
# registers it (SMAppService) when it runs, and the user switches it on
# once in System Settings (Login Items & Extensions), where it's listed
# under Crake. Here:
# - an older Crake's craked (a launchd daemon of its own, in
#   /Library/LaunchDaemons) hands its tunnels over and goes, with its files;
# - a craked the app registered, if it runs, hands its tunnels over and
#   starts again on the new binary;
# - Crake opens for whoever is at the screen, so it registers its service
#   (macOS asks then), quitting an older Crake still running first.
# The tunnels come back signed in (craked's manager/handover.rs) when the
# new craked starts within two minutes: at once on an upgrade, once the
# user switches the service on when coming from an older Crake.
LABEL=software.dorhawk.craked
OLD=/Library/LaunchDaemons/$LABEL.plist
handover() {
    mkdir -p /var/run/crake
    : > /var/run/crake/handover
}
if [ -e "$OLD" ]; then
    if launchctl print "system/$LABEL" >/dev/null 2>&1; then
        handover
        launchctl bootout "system/$LABEL" 2>/dev/null || true
    fi
    rm -f "$OLD" /usr/local/sbin/craked
elif launchctl print "system/$LABEL" >/dev/null 2>&1; then
    handover
    launchctl kickstart -k "system/$LABEL" || true
fi
user=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$user" ] && [ "$user" != root ] && [ "$user" != loginwindow ]; then
    uid=$(id -u "$user")
    pkill -x -U "$uid" crake 2>/dev/null && sleep 1
    launchctl asuser "$uid" sudo -u "$user" open -a /Applications/Crake.app || true
fi
exit 0
