<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "Start when you log in": Crake, started in the user's graphical
     session at login with the flag that switches on the tunnels left on.
     Registered by Crake.app itself (SMAppService;
     Crake.app/Contents/Library/LaunchAgents) when the user switches it on
     in Settings, so System Settings lists it under Crake. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>software.dorhawk.crake</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/crake</string>
    <key>ProgramArguments</key>
    <array>
        <string>crake</string>
        <string>--autostart</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>software.dorhawk.Crake</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
