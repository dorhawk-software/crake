<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- craked as a launchd daemon, registered by Crake.app itself
     (SMAppService; Crake.app/Contents/Library/LaunchDaemons): root,
     started at boot, started again if it stops; launchd's SIGTERM switches
     every tunnel off. Its log is craked's own, /var/db/crake/craked.log
     (root's alone, started again past 8 MB); stderr here holds only what
     comes before that opens, or a crash. Its program is named by
     its place in the app (BundleProgram), so System Settings lists it
     under Crake, where the user switches it on once, not under the signing
     certificate's name (a daemon a package puts in /Library/LaunchDaemons
     is listed under that name; macOS curates names only for well-known
     vendors). Its label isn't craked's of 0.6 and before
     (software.dorhawk.craked): macOS keeps its record of that old daemon,
     and SMAppService, asked about the same label, answered for it
     ("enabled") and registered nothing. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>software.dorhawk.crake.daemon</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/craked</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>software.dorhawk.Crake</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/craked.log</string>
</dict>
</plist>
