<?xml version="1.0" encoding="utf-8"?>
<!-- The installer's pages around Crake's one package (productbuild). -->
<installer-gui-script minSpecVersion="2">
    <title>Crake</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="crake"/>
    </choices-outline>
    <choice id="crake" visible="false">
        <pkg-ref id="software.dorhawk.crake"/>
    </choice>
    <pkg-ref id="software.dorhawk.crake" version="@VERSION@" onConclusion="none">crake.pkg</pkg-ref>
</installer-gui-script>
