[Unit]
Description=Crake's IPsec engine (strongSwan's charon)
Documentation=https://dorhawk.software
# craked starts it for the first IPsec tunnel switched on (CLAUDE.md, 7k)
# and stops it as it leaves; it never runs without craked.
BindsTo=craked.service
After=craked.service
# Not installed (strongSwan is suggested, not required): nothing to run.
ConditionFileIsExecutable=@CHARON@

[Service]
Type=simple
ExecStart=@CHARON@
# craked's settings for it, written before craked starts this unit: its
# own vici socket, random ports, no routes or addresses of its own
# (crates/craked/src/ipsec/charon.rs).
Environment=STRONGSWAN_CONF=/run/crake/ipsec/strongswan.conf
Environment=LC_ALL=C
# A /run of its own: charon's pid file (/run/charon.pid, its path built
# in) is then never a system strongSwan's, which would keep it from
# starting; craked's folder is bound back in for its settings, its vici
# socket and the hook's socket.
TemporaryFileSystem=/run
BindPaths=/run/crake
# Fedora's charon keeps its pid file in /run/strongswan: a folder craked
# makes beside the settings (an ExecStartPre's mkdir made it in a /run of
# its own, and Ubuntu 26.04's mkdir is a path AppArmor's profile doesn't
# name).
BindPaths=-/run/crake/ipsec/run:/run/strongswan
# Its own AppArmor profile (packaging/apparmor/crake-charon), not the one
# a distribution attaches to charon's path, which allows /etc/strongswan*
# and /run/charon.* only. Ignored where AppArmor isn't on.
AppArmorProfile=-crake-charon
# SELinux (Fedora) runs charon as strongSwan's own (ipsec_t): the RPM's
# module (packaging/selinux/crake.te) lets it use craked's folder.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_IPC_LOCK
ProtectHome=yes
PrivateTmp=yes
