#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # craked's AppArmor profile, in place before craked (re)starts.
    if aa-enabled --quiet 2>/dev/null; then
        apparmor_parser -r -T -W /etc/apparmor.d/usr.sbin.craked || true
    fi
    # D-Bus reads the new policy; systemd the new unit.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
        systemctl reload dbus.service >/dev/null 2>&1 || true
    fi
    deb-systemd-helper unmask craked.service >/dev/null || true
    deb-systemd-helper enable craked.service >/dev/null || true
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke restart craked.service >/dev/null || true
    fi
fi
