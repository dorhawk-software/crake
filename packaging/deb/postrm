#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
fi
if [ "$1" = remove ]; then
    deb-systemd-helper mask craked.service >/dev/null || true
fi
if [ "$1" = remove ] || [ "$1" = purge ]; then
    # Unload craked's AppArmor profile (its file stays until purge).
    if [ -f /etc/apparmor.d/usr.sbin.craked ] && aa-enabled --quiet 2>/dev/null; then
        apparmor_parser -R /etc/apparmor.d/usr.sbin.craked >/dev/null 2>&1 || true
    fi
fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge craked.service >/dev/null || true
    deb-systemd-helper unmask craked.service >/dev/null || true
    # What craked learned and logged.
    rm -rf /var/lib/crake
fi
