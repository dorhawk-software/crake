#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
fi
if [ "$1" = remove ]; then
    deb-systemd-helper mask craked.service >/dev/null || true
fi
if [ "$1" = remove ] || [ "$1" = purge ]; then
    # Unload craked's AppArmor profiles (their files stay until purge).
    for p in usr.sbin.craked crake-charon; do
        if [ -f "/etc/apparmor.d/$p" ] && aa-enabled --quiet 2>/dev/null; then
            apparmor_parser -R "/etc/apparmor.d/$p" >/dev/null 2>&1 || true
        fi
    done
fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge craked.service >/dev/null || true
    deb-systemd-helper unmask craked.service >/dev/null || true
    # What craked learned and logged.
    rm -rf /var/lib/crake
fi
