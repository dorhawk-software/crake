# Crake's settings for the practices kit in .practices/bin (the defaults:
# .practices/bin/lib.sh; what each means: dorhawk-software/practices).

# The vendored GPUI patch isn't Crake's own code.
EXCLUDE=':!vendor'

# Unsafe code lives in crates/crake-os alone, behind safe functions
# (CLAUDE.md, "the unsafe layer"); every other crate forbids it.
UNSAFE_ALLOWED='crates/crake-os'

# dev/private-terms (git-ignored) lists the user's clients' names, hosts
# and addresses: CLAUDE.md's Git rules.
PRIVATE_TERMS=dev/private-terms

# The tests that need a real gateway (CRAKE_E2E: the scenario suite, the
# e2e tests, the journeys, the gateway tests and their helpers) are test
# code `cargo test` can't run, measured by running them: left out of the
# share (2026-10-20, when the scenario suite's growth alone took crake
# under its floor; the floor then rose from 66 to 73, what crake's own
# code had without them).
COVERAGE_EXCLUDE='^crates/crake/src/(scenarios/|e2e_|journey_|gateway_tests/|windows_tests|windows_journey|macos_journey|test_app|journey_kit)'

# check-ui measures the approved screens, the UI's spec (CLAUDE.md, "Read
# first"). design/proposals/ is the record of what was proposed, agreed
# or rejected, kept as it was shown; measuring it would mean rewriting
# history (2026-11-16, practices 1.6.4).
UI_BOARDS=':(glob)design/screens/*.html'

# check-voice reads Crake's copy where it lives: the Rust code of the app,
# the daemon and the protocol crate (their strings reach the screen, the
# log and the helpdesk copy), and the changelog. Test fixtures that quote
# a gateway's own prompt are marked on their line (2026-11-16).
VOICE_FILES=':(glob)CHANGELOG.md :(glob)crates/crake/src/**/*.rs :(glob)crates/craked/src/**/*.rs :(glob)crates/crake-proto/src/**/*.rs'

# Crake's copy is English: its strings, the changelog and the boards that
# name no language (practices 1.7, 2026-11-27).
COPY_LANG=en

# check-page reads the proposal and review pages written from now on. The
# 68 from before the rule (practices 1.12's phone widths, 1.16's reviewed
# mocks) stay as they were shown, for the reason UI_BOARDS gives above:
# they are the record. .practices/pages-before-the-rule lists them and
# only shrinks; a page changed or shown again leaves it (2026-11-27).
# Crake is a desktop app, but its owner reads proposals on a phone too, so
# the widths stay the kit's.
UI_PAGES=':(glob)design/proposals/**/*.html :(glob)design/changes/**/*.html'
while IFS= read -r before; do
    case $before in '' | '#'*) continue ;; esac
    UI_PAGES="$UI_PAGES :(exclude)$before"
done <.practices/pages-before-the-rule
unset before
