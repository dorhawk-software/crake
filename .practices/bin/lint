#!/usr/bin/env bash
# The lint gate: every check that must pass before a build counts. It is
# quiet when everything passes and prints only what failed, so an agent's
# context stays small.
#
#   .practices/bin/lint
#
# The checks: rustfmt; clippy on all targets (Cargo.toml's
# [workspace.lints] make every lint an error); cargo deny (advisories,
# licences, sources); cargo machete (unused dependencies); no private
# names (check-private); file sizes (check-size); unsafe only where
# allowed (check-unsafe); the git hooks installed (not in CI); then every
# executable file in .practices/lint.d/, the project's own checks.
#
# Run by the Claude Code hook after cargo builds and tests (claude-hook),
# by the pre-commit hook when Rust files are committed, and in CI.

# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

fail=0
step() {
    local name=$1 out
    shift
    if ! out=$("$@" 2>&1); then
        printf '%s failed:\n%s\n\n' "$name" "$out"
        fail=1
    fi
}

step "rustfmt (run cargo fmt)" cargo fmt --all --check
step "clippy" cargo clippy --workspace --all-targets --quiet
step "cargo deny" cargo deny --log-level error check
step "cargo machete" cargo machete
step "private names" "$PRACTICES_BIN/check-private"
step "file sizes" "$PRACTICES_BIN/check-size"
step "unsafe code" "$PRACTICES_BIN/check-unsafe"
if [ -z "${CI:-}" ]; then
    step "git hooks (run .practices/bin/install-hooks)" "$PRACTICES_BIN/install-hooks" --check
fi
for extra in .practices/lint.d/*; do
    if [ -f "$extra" ] && [ -x "$extra" ]; then
        step "$(basename "$extra")" "$extra"
    fi
done

exit $fail
