#!/usr/bin/env bash
# The permission-button gate: a button that leads to a system permission
# prompt says Continue or Next, never "Allow", "Enable", "Turn on" or
# "Give access" (mobile/app-review.md). It reads the copy files
# (VOICE_FILES) and the code (PERMISSION_FILES): a button-like string
# that is a grant verb and a permission ("Allow notifications", "Povolit
# Čas u obrazovky", "Permitir acceso") is a finding anywhere; a bare
# "Allow" is one in a file that asks the OS for a permission. English,
# Czech, Spanish and Vietnamese; PERMISSION_VERBS and PERMISSION_NOUNS add
# words. A string catalog's stale entries are skipped; the rest count.
# The reading is in permission-audit.py.
#
#   .practices/bin/check-permission-words            # every copy and code file
#   .practices/bin/check-permission-words FILE...    # just these
#
# A string that isn't the button before a prompt (a step in a guide that
# names a setting) is marked on its line or the one above, or in the
# catalog entry's comment, with a reason of three words or more:
#   // practices-allow permission: names the Settings switch
#
# Why: on 16 Nov 2026 App Review refused an iPhone app (Guideline
# 5.1.1(iv)) for an "ALLOW SCREEN TIME ACCESS" button before the Screen
# Time prompt: "Use words like 'Continue' or 'Next' on the button instead."
#
# Needs python3; without it, it fails, never passes.

# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

if [ $# -gt 0 ]; then
    files=("$@")
else
    files=()
    while IFS= read -r f; do
        [ -f "$f" ] && files+=("$f")
    done < <(permission_files)
fi
if [ ${#files[@]} = 0 ]; then
    echo "check-permission-words: no copy or code files (VOICE_FILES, PERMISSION_FILES in .practices/config), nothing to check."
    exit 0
fi
if ! command -v python3 >/dev/null; then
    echo "check-permission-words: needs python3, which isn't installed; the buttons are unchecked."
    exit 2
fi
python3 "$PRACTICES_BIN/permission-audit.py" --verbs "$PERMISSION_VERBS" --nouns "$PERMISSION_NOUNS" "${files[@]}"
