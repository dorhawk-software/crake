#!/usr/bin/env bash
# The motion gate: a selection switches at once (ui/visual-craft.md). In
# the Swift files (MOTION_FILES) it finds a selection state set inside
# withAnimation, or followed by .animation(_:value:). Animated, the old
# and the new choice cross-fade, and for a moment both are half lit. A
# selection state is a name matched whole by MOTION_SELECTION (default:
# selected..., selection..., highlighted..., ...Selection, ...Selected).
# The reading is in motion-audit.py.
#
#   .practices/bin/check-motion            # every Swift file
#   .practices/bin/check-motion FILE...    # just these
#
# A highlight that slides from the old choice to the new one on purpose
# is marked on the line or the line above, with a reason of three words
# or more:
#   // practices-allow motion: the capsule slides between tabs
#
# Why: on 25 Nov 2026 an iPhone app's two-week chart flickered on every
# tap on a bar. withAnimation(.snappy) set the selected day, and the old
# and the new bar faded across each other. Apple's own chart switches at
# once. Kotlin, Compose and the web aren't read yet (ROADMAP.md).
#
# Needs python3; without it, it fails, never passes.

# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

if [ $# -gt 0 ]; then
    files=()
    for f in "$@"; do
        case $f in *.swift) files+=("$f") ;; esac
    done
else
    files=()
    while IFS= read -r f; do
        [ -f "$f" ] && files+=("$f")
    done < <(motion_files)
fi
if [ ${#files[@]} = 0 ]; then
    echo "check-motion: no Swift files (MOTION_FILES in .practices/config), nothing to check."
    exit 0
fi
if ! command -v python3 >/dev/null; then
    echo "check-motion: needs python3, which isn't installed; the selections are unchecked."
    exit 2
fi
python3 "$PRACTICES_BIN/motion-audit.py" --names "$MOTION_SELECTION" "${files[@]}"
